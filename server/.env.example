# Porta em que este servidor vai escutar
PORT=3001

# Origem exata do painel BarberPro que pode chamar este endpoint (CORS)
ALLOWED_ORIGIN=https://seu-painel-barberpro.com

# Dados da sua Evolution API — NUNCA vão para o frontend
EVOLUTION_API_URL=https://seu-servidor-evolution.com

# Chave ESCOPADA a uma instância (hoje "barberpro"). Usada só em /whatsapp/status.
EVOLUTION_API_KEY=sua_api_key_da_evolution

# Chave GLOBAL/admin do servidor Evolution — a única com permissão para criar
# instâncias novas (POST /instance/create). Usada só em /whatsapp/conectar.
# É uma credencial DIFERENTE de EVOLUTION_API_KEY — não confundir nem reusar.
EVOLUTION_ADMIN_API_KEY=

# Instância usada quando a empresa ainda não tem evolutionInstance salvo no Firestore
EVOLUTION_DEFAULT_INSTANCE=barberpro

# Caminho local do arquivo JSON da service account do Firebase
# (Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Token secreto compartilhado só com o n8n, para autenticar as chamadas
# machine-to-machine dos endpoints /agenda/*. Gere uma string aleatória
# longa (ex: openssl rand -hex 32) e configure o MESMO valor no header
# Authorization do node HTTP Request no n8n. NUNCA vai para o frontend.
N8N_SERVICE_TOKEN=

# URL de produção do webhook do n8n (node "Webhook Evolution API"). Usada só
# em /whatsapp/conectar pra configurar automaticamente o webhook de CADA
# instância nova/reconectada (evento MESSAGES_UPSERT) — sem isso, uma
# empresa nova nunca teria suas mensagens chegando no n8n.
N8N_EVOLUTION_WEBHOOK_URL=https://seu-n8n.com/webhook/seu-webhook-id
